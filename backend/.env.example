# PostgreSQL + PostGIS connection string. The prefix MUST be postgresql+psycopg
# (psycopg v3) — not postgresql:// and not postgresql+psycopg2://.
#
# This is the ONLY place the database location is configured. Nothing in the application
# code knows or cares where the database lives, so moving it is a one-line change here:
#
#   local development      postgresql+psycopg://postgres:postgres@localhost:5432/sericulture_mis
#   SDC production         postgresql+psycopg://seri_app:<password>@192.168.18.194:5432/sericulture_mis
#   (historical) Supabase  postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sericulture_mis

# Comma-separated list of allowed frontend origins for CORS.
# In production the frontend and API are served from one origin through Caddy, so this is
# a defensive second layer rather than something the browser actually exercises.
#   production: https://silkmis.assam.gov.in
CORS_ORIGINS=http://localhost:3000

# Generate fresh random secrets for any real deployment — never reuse these placeholders.
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Protects farmer Aadhaar numbers at rest (see backend/app/core/aadhaar.py). Required —
# the app will not boot without it. Generate with: openssl rand -hex 32
#
# WARNING: this key CANNOT be rotated or lost. Losing it makes every stored Aadhaar
# permanently undecryptable AND silently breaks duplicate-Aadhaar detection (the blind
# index is derived from it). Back it up in a password manager.
# It must also be IDENTICAL across every environment whose data you copy between —
# HOW_TO_DEMO.md Part 4 syncs rows between the local and cloud databases, and a
# mismatched key makes the copied Aadhaar data unreadable on the other side.
AADHAAR_SECRET_KEY=change-me-run-openssl-rand-hex-32

APP_NAME=sericulture-mis
RATE_LIMIT_LOGIN=5/minute

# DB connection pool sizing — keep low against Supabase free-tier connection caps.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Where uploaded files (photos, passbooks, certificates, minutes) are stored on disk.
# Fixed at /data/uploads by docker-compose's named volume; only override for non-Docker runs.
UPLOAD_ROOT=./file_uploads

# Demo account credentials seeded on first startup.
STATE_ADMIN_MOBILE=9999999999
STATE_ADMIN_PASSWORD=Admin@123
DISTRICT_ADMIN_MOBILE=8888888888
DISTRICT_ADMIN_PASSWORD=District@123
FIG_PRESIDENT_MOBILE=7777777777
FIG_PRESIDENT_PASSWORD=Fig@123
