# PostgreSQL + PostGIS connection string (psycopg v3 dialect).
# Supabase Session Pooler example: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sericulture_mis

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Generate fresh random secrets for any real deployment — never reuse these placeholders.
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

APP_NAME=sericulture-mis
RATE_LIMIT_LOGIN=5/minute

# DB connection pool sizing — keep low against Supabase free-tier connection caps.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Where uploaded files (photos, passbooks, certificates, minutes) are stored on disk.
# Fixed at /data/uploads by docker-compose's named volume; only override for non-Docker runs.
UPLOAD_ROOT=./file_uploads

# Demo account credentials seeded on first startup.
STATE_ADMIN_MOBILE=9999999999
STATE_ADMIN_PASSWORD=Admin@123
DISTRICT_ADMIN_MOBILE=8888888888
DISTRICT_ADMIN_PASSWORD=District@123
FIG_PRESIDENT_MOBILE=7777777777
FIG_PRESIDENT_PASSWORD=Fig@123
